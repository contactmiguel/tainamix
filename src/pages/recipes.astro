<BaseLayout
  title="Recipes"
  description="Browse 90+ hand-picked Thermomix® recipes from Taina's Cookidoo® collection. Filter by category and cook with confidence."
  activePage="recipes"
>

  <!-- ─── Hero ─────────────────────────────────────────────────────── -->
  <section class="pt-10 pb-6 px-margin-desktop max-w-container-max mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="material-symbols-outlined text-primary text-[20px]">menu_book</span>
          <span class="font-label-md text-label-md text-primary uppercase tracking-widest">Cookidoo® Collection</span>
        </div>
        <h1 class="font-headline-display text-headline-display text-on-background">Taina's Recipe Collection</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant mt-2 max-w-xl">
          {recipes.length} hand-picked recipes across {categories.length - 1} categories — each one linked directly to Cookidoo® so you can cook along.
        </p>
      </div>
      <a
        href="https://cookidoo.us"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 flex items-center gap-2 px-6 py-3 bg-primary text-on-primary rounded-xl font-label-md text-label-md shadow-sm hover:brightness-110 transition-all self-start md:self-auto"
      >
        <span class="material-symbols-outlined text-[18px]">open_in_new</span>
        Browse All on Cookidoo®
      </a>
    </div>
  </section>

  <!-- ─── Sticky Filter Bar ─────────────────────────────────────────── -->
  <div class="sticky top-[64px] z-40 bg-surface/95 backdrop-blur-md border-b border-outline-variant/20 py-3 px-margin-desktop">
    <div class="max-w-container-max mx-auto flex flex-col gap-3">

      <!-- Search -->
      <div class="relative max-w-sm">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none">search</span>
        <input
          id="recipe-search"
          type="search"
          placeholder="Search recipes…"
          class="w-full pl-10 pr-4 py-2 rounded-xl border border-outline-variant bg-surface-container-lowest font-body-md text-body-md text-on-background focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all"
        />
      </div>

      <!-- Category pills — horizontal scroll on mobile -->
      <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1">
        {categories.map((cat, i) => (
          <button
            data-filter={cat}
            class={`filter-pill shrink-0 px-4 py-1.5 rounded-full font-label-md text-label-md border transition-all whitespace-nowrap ${i === 0 ? 'bg-primary text-on-primary border-primary' : 'bg-surface-container-low text-on-surface-variant border-outline-variant hover:border-primary hover:text-primary'}`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── Recipe Grid ───────────────────────────────────────────────── -->
  <section class="py-8 px-margin-desktop max-w-container-max mx-auto">
    <p id="recipe-count" class="font-label-md text-label-md text-on-surface-variant mb-6">
      Showing all {recipes.length} recipes
    </p>

    <div id="recipe-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-gutter">
      {recipes.map(r => (
        <a
          href={r.url}
          target="_blank"
          rel="noopener noreferrer"
          data-category={r.category}
          data-name={r.name.toLowerCase()}
          class="recipe-card group bg-white rounded-2xl overflow-hidden recipe-card-shadow hover:-translate-y-1 transition-transform duration-300 flex flex-col"
        >
          <!-- Image -->
          <div class="aspect-[4/3] overflow-hidden bg-surface-container-low">
            <img
              src={r.img}
              alt={r.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <!-- Body -->
          <div class="p-4 flex flex-col flex-1">
            <span
              class="self-start text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full mb-2 leading-5"
              style={categoryStyle[r.category]}
            >
              {r.category}
            </span>
            <h3 class="font-label-md text-label-md text-on-background leading-snug flex-1 mb-3">{r.name}</h3>
            <div class="flex items-center gap-1 text-primary text-[12px] font-semibold">
              View on Cookidoo®
              <span class="material-symbols-outlined text-[14px]">open_in_new</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty state -->
    <div id="no-results" class="hidden text-center py-24">
      <span class="material-symbols-outlined text-5xl text-on-surface-variant mb-4 block">search_off</span>
      <p class="font-headline-md text-headline-md text-on-surface-variant mb-2">No recipes found</p>
      <p class="font-body-md text-on-surface-variant">Try a different search term or select another category.</p>
      <button id="reset-btn" class="mt-6 px-6 py-2 border border-primary text-primary rounded-full font-label-md hover:bg-primary hover:text-on-primary transition-all">
        Show all recipes
      </button>
    </div>
  </section>

</BaseLayout>

<script is:inline>
  let activeCategory = 'All';
  let searchTerm = '';

  const cards     = document.querySelectorAll('.recipe-card');
  const pills     = document.querySelectorAll('.filter-pill');
  const countEl   = document.getElementById('recipe-count');
  const noResults = document.getElementById('no-results');
  const searchEl  = document.getElementById('recipe-search');
  const resetBtn  = document.getElementById('reset-btn');
  const total     = cards.length;

  function applyFilter() {
    let visible = 0;
    cards.forEach(card => {
      const cat  = card.dataset.category;
      const name = card.dataset.name || '';
      const catOk  = activeCategory === 'All' || cat === activeCategory;
      const nameOk = !searchTerm || name.includes(searchTerm);
      const show = catOk && nameOk;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (visible === total && !searchTerm) {
      countEl.textContent = `Showing all ${total} recipes`;
    } else {
      countEl.textContent = `Showing ${visible} of ${total} recipes`;
    }

    noResults.classList.toggle('hidden', visible > 0);
  }

  function setCategory(cat) {
    activeCategory = cat;
    pills.forEach(p => {
      const active = p.dataset.filter === cat;
      p.classList.toggle('bg-primary',              active);
      p.classList.toggle('text-on-primary',         active);
      p.classList.toggle('border-primary',          active);
      p.classList.toggle('bg-surface-container-low',!active);
      p.classList.toggle('text-on-surface-variant', !active);
      p.classList.toggle('border-outline-variant',  !active);
    });
    applyFilter();
  }

  pills.forEach(p => p.addEventListener('click', () => setCategory(p.dataset.filter)));

  searchEl?.addEventListener('input', e => {
    searchTerm = e.target.value.toLowerCase().trim();
    applyFilter();
  });

  resetBtn?.addEventListener('click', () => {
    searchTerm = '';
    searchEl.value = '';
    setCategory('All');
  });
</script>
