---
import NewsletterBar from './NewsletterBar.astro';
---

<footer class="bg-surface-container-low border-t border-outline-variant">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter px-margin-desktop py-stack-lg max-w-container-max mx-auto">

    <!-- Col 1: Brand -->
    <div class="col-span-1">
      <a href="/" class="block mb-stack-sm">
        <img src="/images/logo.png" alt="TainaMix" class="h-10 w-auto" />
      </a>
      <p class="font-body-md text-body-md text-on-surface-variant">
        Culinary precision for the modern kitchen. Your bilingual Thermomix® consultant in LA.
      </p>
    </div>

    <!-- Col 2: Explore -->
    <div>
      <p class="font-label-md text-label-md text-primary font-semibold mb-stack-md uppercase tracking-wider">Explore</p>
      <ul class="space-y-stack-sm">
        <li><a href="/"           class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all">Home</a></li>
        <li><a href="/about"      class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all">About Me</a></li>
        <li><a href="/thermomix"  class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all">The Thermomix®</a></li>
        <li><a href="/recipes"    class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all">Recipes</a></li>
        <li><a href="/resources"  class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all">Resources</a></li>
        <li><a href="/shop"       class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all">Shop</a></li>
        <li><a href="/demo"       class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all">Book a Demo</a></li>
      </ul>
    </div>

    <!-- Col 3: Connect -->
    <div>
      <p class="font-label-md text-label-md text-primary font-semibold mb-stack-md uppercase tracking-wider">Connect</p>
      <ul class="space-y-stack-sm">
        <li>
          <a href="https://www.instagram.com/tainamix" target="_blank" rel="noopener noreferrer"
             class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all flex items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            Instagram
          </a>
        </li>
        <li>
          <a href="https://www.youtube.com/@tainamix" target="_blank" rel="noopener noreferrer"
             class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all flex items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
              <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
            </svg>
            YouTube
          </a>
        </li>
        <li>
          <a href="https://www.facebook.com/groups/tainamix/" target="_blank" rel="noopener noreferrer"
             class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all flex items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12.5 21v-9"/>
              <path d="M9.5 13.5h6"/>
              <path d="M12.5 12V9.5a2.5 2.5 0 0 1 2.5-2.5H16"/>
            </svg>
            Facebook
          </a>
        </li>
        <li>
          <a href="https://wa.me/13107175565" target="_blank" rel="noopener noreferrer"
             class="font-body-md text-body-md text-on-secondary-container hover:text-primary hover:underline transition-all flex items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
            WhatsApp
          </a>
        </li>
      </ul>
    </div>

    <!-- Col 4: Newsletter -->
    <div>
      <p class="font-label-md text-label-md text-primary font-semibold mb-stack-md uppercase tracking-wider">Newsletter</p>
      <p class="font-body-md text-body-md text-on-surface-variant mb-stack-md text-sm">
        Recipes, Thermomix® tips, and exclusive event invites.
      </p>
      <NewsletterBar compact={true} />
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="max-w-container-max mx-auto px-margin-desktop py-stack-md border-t border-outline-variant/30 flex flex-col md:flex-row justify-between items-center gap-2">
    <p class="font-label-md text-label-md text-on-surface-variant text-sm">
      © 2025 TainaMix. All rights reserved. · LA Independent Consultant · Taina F.
    </p>
    <div class="flex gap-stack-md">
      <a href="/privacy" class="font-label-md text-label-md text-on-surface-variant hover:text-primary text-sm transition-colors">Privacy Policy</a>
      <a href="/demo"    class="font-label-md text-label-md text-on-surface-variant hover:text-primary text-sm transition-colors">Contact Us</a>
    </div>
  </div>
</footer>
