---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const uniqueId = Math.random().toString(36).substr(2, 9);
---

<form
  action="https://thermotaina.us14.list-manage.com/subscribe/post?u=429998365501c54e1d129e323&id=b0a921dbbb&f_id=004fb5e5f0"
  method="POST"
  id={`mc-embedded-subscribe-form-${uniqueId}`}
  name={`mc-embedded-subscribe-form-${uniqueId}`}
  class="validate"
  novalidate
>
  <div id={`mc_embed_signup_scroll-${uniqueId}`} class={compact ? 'flex flex-col gap-2' : 'flex gap-2 w-full max-w-lg'}>
    <input
      type="email"
      value=""
      name="EMAIL"
      class={`required email ${compact ? 'w-full' : 'flex-1'} bg-surface border-none rounded-xl px-6 py-3 font-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:ring-2 focus:ring-primary/20 focus:outline-none`}
      id={`mce-EMAIL-${uniqueId}`}
      placeholder="Your email address"
    />
    <div aria-hidden="true" style="position: absolute; left: -5000px;">
      <input type="text" name="b_429998365501c54e1d129e323_b0a921dbbb" tabindex="-1" value="">
    </div>
    <button
      type="submit"
      value="Subscribe"
      name="subscribe"
      id={`mc-embedded-subscribe-${uniqueId}`}
      onclick={`showNewsletterSuccess(event, '${uniqueId}')`}
      class={`${compact ? 'w-full' : ''} bg-primary text-on-primary px-6 py-3 rounded-xl font-label-md text-label-md hover:brightness-110 active:scale-95 transition-all`}
    >
      Subscribe
    </button>
    <div id={`mc-success-message-${uniqueId}`} style="display:none;" class={`${compact ? 'w-full' : ''} bg-primary text-on-primary px-6 py-3 rounded-xl font-label-md text-label-md text-center`}>
      You have been added to our list.
    </div>
  </div>
</form>

<script defer src="//s3.amazonaws.com/downloads.mailchimp.com/js/mc-validate.js"></script>
<script is:inline>
function showNewsletterSuccess(e, uniqueId) {
  e.preventDefault();
  const email = document.getElementById(`mce-EMAIL-${uniqueId}`);
  if (email && email.value) {
    const button = document.getElementById(`mc-embedded-subscribe-${uniqueId}`);
    const successMsg = document.getElementById(`mc-success-message-${uniqueId}`);
    const form = document.getElementById(`mc-embedded-subscribe-form-${uniqueId}`);
    if (button && successMsg && form) {
      button.style.display = 'none';
      successMsg.style.display = 'block';

      const formData = new FormData(form);
      fetch(form.action, {
        method: 'POST',
        body: formData
      }).catch(() => {});
    }
  }
}

</script>
